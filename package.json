{
  "name": "raumplaner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Raumplaner – Räume in 2D zeichnen, in 3D einrichten, Materialien wählen und Sonnenlicht simulieren",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "6.4.1",
    "vite-plugin-singlefile": "2.3.0"
  }
}
